# Copy to .env.local (gitignored) and fill in. NEVER commit real values — this repository
# is public, and behind the admin login sits data about children.
#
# Generate all three with:
#   node scripts/hash-password.ts <username> <password>
#
# In production set the same three as Cloudflare secrets, NOT as build variables:
#   npx wrangler secret put ADMIN_USERNAME
#   npx wrangler secret put ADMIN_PASSWORD_HASH
#   npx wrangler secret put AUTH_SECRET

# The operator username, in full.
ADMIN_USERNAME=

# A PBKDF2 hash, never the password itself. Dot-separated on purpose: `$` is variable
# expansion syntax to dotenv and to every shell, and it silently truncates the value.
ADMIN_PASSWORD_HASH=

# Signs the session cookie. Rotating this ends every signed-in session immediately, which is
# the only revocation this design has — so rotate it if you ever suspect a leak.
AUTH_SECRET=

# Phase 2. Student accounts and the telemetry collector stay inert until these are set;
# nothing breaks without them.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
