# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# next.js
/.next/
/.next-dev/
/out/
next-env.d.ts

# production
/build

# testing
/coverage
/.vitest

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env
.env
.env*.local
# Wrangler's local secrets. The operator credentials live HERE rather than in .env.local,
# because anything Next's env loader reads gets baked into the deployed worker bundle.
# See scripts/check-build-secrets.ts.
.dev.vars
.dev.vars.*

# vercel
.vercel

# typescript
*.tsbuildinfo

# supabase
supabase/.branches
supabase/.temp

# Cloudflare Workers build output (generated by `pnpm cf:build`)
.open-next/
.wrangler/
